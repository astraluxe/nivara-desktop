# Dependencies
node_modules/

# Build output
dist/
dist-harness/
dist-visual/
src-tauri/target/

# Environment files
.env
.env.local
.env*.local

# Tauri signing keys — NEVER commit private key
.tauri/*.key
!.tauri/*.key.pub

# OS
.DS_Store
Thumbs.db

# IDE
.vscode/
.idea/

# Bundled resource binaries — downloaded/built by CI, not committed to git
src-tauri/resources/voice/*.exe
src-tauri/resources/voice/*.bin
src-tauri/resources/mesh/*.exe

# One-off patch scripts (already applied, kept locally for reference)
fix_*.cjs

# latest.json used to be ignored as "a build artifact uploaded to GitHub releases". It is now also
# SERVED from this repo, via raw.githubusercontent.com, because the release CDN
# (objects/release-assets.githubusercontent.com) is SNI-filtered on some ISPs — measured: same IPs,
# TCP 443 connects, TLS never completes — which left the updater unable to read its own manifest.
# raw.githubusercontent.com is reachable on those networks, so the manifest is committed on purpose.

# Screenshots the visual harness writes — build artefacts, not source.
visual-*.png
dist-visual/
