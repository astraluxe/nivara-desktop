{
  "name": "nivara-desktop",
  "private": true,
  "version": "1.80.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "check:colours": "node scripts/check-dept-colours.mjs",
    "check:roster": "node scripts/check-agent-roster.mjs",
    "check:delegation": "node scripts/check-delegation-rule.mjs",
    "build": "node scripts/check-dept-colours.mjs && node scripts/check-agent-roster.mjs && node scripts/check-delegation-rule.mjs && node scripts/check-boss-tools.mjs && node scripts/check-ai-source.mjs && node scripts/check-tips.mjs && node scripts/check-classes.mjs && node scripts/check-ai-callers.mjs && node scripts/check-office-graph.mjs && node scripts/check-tool-coverage.mjs && node scripts/check-ui-reachable.mjs && node scripts/check-app-launch.mjs && node scripts/check-source-chars.mjs && node scripts/check-chat-affordances.mjs && node scripts/check-brand-contrast.mjs && node scripts/check-plan-source.mjs && tsc && vite build",
    "preview": "vite preview",
    "harness:build": "vite build --config vite.harness.config.ts --outDir dist-harness",
    "test:ui": "node harness/run-tests.mjs",
    "test:webmail": "node harness/fake-webmail.mjs",
    "visual": "vite build --config vite.visual.config.ts --outDir dist-visual && node harness/shoot.mjs",
    "tauri": "tauri",
    "bundle-exo": "node scripts/bundle-exo.js",
    "tauri:build": "npm run bundle-exo && tauri build",
    "check:bosstools": "node scripts/check-boss-tools.mjs",
    "check:aisource": "node scripts/check-ai-source.mjs",
    "check:tips": "node scripts/check-tips.mjs",
    "check:classes": "node scripts/check-classes.mjs",
    "check:aicallers": "node scripts/check-ai-callers.mjs",
    "check:officegraph": "node scripts/check-office-graph.mjs",
    "check:toolcoverage": "node scripts/check-tool-coverage.mjs",
    "check:uireachable": "node scripts/check-ui-reachable.mjs",
    "_comment:urls": "check-external-urls hits the real internet, so it is NEVER in the build — run it by hand before a release",
    "check:urls": "node scripts/check-external-urls.mjs",
    "check:applaunch": "node scripts/check-app-launch.mjs",
    "check:chars": "node scripts/check-source-chars.mjs",
    "check:chat": "node scripts/check-chat-affordances.mjs",
    "check:brand": "node scripts/check-brand-contrast.mjs",
    "check:plan": "node scripts/check-plan-source.mjs"
  },
  "dependencies": {
    "@monaco-editor/react": "^4.7.0",
    "@supabase/supabase-js": "^2.49.4",
    "@tauri-apps/api": "^2.5.0",
    "@tauri-apps/plugin-autostart": "^2.5.1",
    "@tauri-apps/plugin-shell": "^2.3.5",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/xterm": "^6.0.0",
    "@xyflow/react": "^12.10.2",
    "jspdf": "^2.5.2",
    "monaco-editor": "^0.55.1",
    "pdfjs-dist": "^5.7.284",
    "pptxgenjs": "^3.12.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.5.0",
    "@types/react": "^18.3.20",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.21",
    "postcss": "^8.5.3",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.8.3",
    "vite": "^6.3.5"
  }
}
